# Configuração do Supabase (PostgreSQL + Auth + Storage)
# Quando criar o projeto no Supabase, copie este arquivo para .env.local e preencha:
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Simulador de manipuladores (/simulador-manipuladores)
# Senha do professor para ver o gabarito da tabela DH. Fica só no servidor (Vercel > Settings > Environment Variables).
# Sem esta variável o gabarito fica bloqueado para todos.
SIMULADOR_GABARITO_SENHA=
